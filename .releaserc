{
  "plugins": [
    "@semantic-release/commit-analyzer",
    ["@semantic-release/release-notes-generator", { "writerOpts": { "headerPartial": "" } }],
    ["@semantic-release/npm", { "npmPublish": false }],
    [
      "@semantic-release/exec",
      { "prepareCmd": "node scripts/release.mjs ${nextRelease.version} && npm run pack" }
    ],
    [
      "@semantic-release/git",
      {
        "assets": ["package.json", "package-lock.json", "Info.json"],
        "message": "chore(release): ${nextRelease.version}"
      }
    ],
    [
      "@semantic-release/github",
      {
        "assets": ["dist/alldebrid.iinaplgz"],
        "failCommentCondition": false,
        "successCommentCondition": false,
        "releasedLabels": false
      }
    ]
  ]
}
