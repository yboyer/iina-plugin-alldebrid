{
  "name": "iina-alldebrid",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "typecheck": "tsc --noEmit && tsc --noEmit -p tests",
    "lint": "biome check .",
    "build": "npm run typecheck && vite build && vite build --mode ui && node scripts/assets.mjs",
    "test": "npm run build && node --test tests/*.test.mts tests/*.test.cjs",
    "pack": "npm run build && python3 scripts/pack.py"
  },
  "dependencies": {
    "parse-torrent-title": "3.0.1"
  },
  "devDependencies": {
    "@yboyer/config": "1.5.2",
    "@biomejs/biome": "^2.5.15",
    "@types/node": "^24.0.0",
    "typescript": "^6.0.0",
    "vite": "8.3.2"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "type": "module"
}
